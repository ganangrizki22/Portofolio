# Port tempat server Express berjalan
PORT=5000

# Origin frontend yang diizinkan mengakses API (CORS). Boleh diisi beberapa
# sekaligus, dipisah koma -- berguna kalau port 5173 kebetulan sudah dipakai
# project lain yang dibuka bersamaan, sehingga Vite otomatis pindah ke
# 5174/5175, dst.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ==== Spotify "Now Playing" widget ====
# Client ID dari Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=

# Harus didaftarkan juga di app kamu di Spotify Dashboard -> Settings -> Redirect URIs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback

# Kosongkan dulu. Didapat otomatis setelah membuka
# http://localhost:5000/api/spotify/login sekali di browser dan login Spotify.
SPOTIFY_REFRESH_TOKEN=

# ==== Database (Neon PostgreSQL) ====
# Dipakai untuk menyimpan pesan form kontak (menggantikan data/messages.json,
# supaya tidak hilang saat backend di-deploy ke hosting dengan filesystem
# yang tidak permanen).
# Ambil dari Neon Dashboard -> Connection Details -> Connection string.
# Format: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=
